---
import Layout from '../layouts/Layout.astro';
import Navbar from '../component/Navbar.astro';
import Footer from '../component/Footer.astro';
import Prefrence from '../component/Prefrence.astro'
import HeroSection from '../component/HeroSection.astro';
import UseCases from '../component/UseCases.astro';
import Work from '../component/Work.astro';
import PaymentGateway from '../components/PaymentGateway'
import PciCompliance from '../component/PciCompliance.astro'
import '../styles/global.css'
import '../styles/hero.css'
import '../styles/usecases.css'
import Loader from '../component/Loader.astro';

import { graph, organizationSchema, websiteSchema, softwareApplicationSchema, ORG_ID, WEBSITE_ID } from '../utils/schema.js'

const homeSchema = graph([
  organizationSchema,
  websiteSchema,
  softwareApplicationSchema,
  {
    '@type': 'WebPage',
    '@id': 'https://www.unumpay.com/#webpage',
    url: 'https://www.unumpay.com/',
    name: 'Simplify Your Shopify Payments | UnumPay',
    description:
      'Connect your Shopify store to 40+ payment gateways worldwide. Accept local and global payments, track transactions in real time, all in one place.',
    isPartOf: { '@id': WEBSITE_ID },
    about: { '@id': ORG_ID },
    mainEntity: { '@id': 'https://www.unumpay.com/#softwareapplication' },
    primaryImageOfPage: { '@id': 'https://www.unumpay.com/#logo' },
    inLanguage: 'en',
  },
])
---

<Layout title="Simplify Your Shopify Payments | UnumPay"
  description="Connect your Shopify store to 40+ payment gateways worldwide. Accept local and global payments, track transactions in real time, all in one place."
  image="/og-home.jpg"
  schema={homeSchema}>

	<Loader />

	<Navbar />

	<HeroSection />

	<Work />

	<PaymentGateway client:visible />

	<PciCompliance />

	<UseCases />

	<Prefrence />

	<Footer />

</Layout>
