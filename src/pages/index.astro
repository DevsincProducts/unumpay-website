---

<Layout title="Simplify Your Shopify Payments | UnumPay"
  description="Connect your Shopify store to 40+ payment gateways worldwide. Accept payments securely with UnumPay."
  canonical="https://www.unumpay.com/"
  image="https://www.unumpay.com/og-image.jpg">

	<Loader />

	<Navbar />

	<HeroSection />

	<Work />

	<PaymentGateway client:load />

	<UseCases />

	<Prefrence />

	<Footer />

</Layout>
