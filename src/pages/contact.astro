---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css'
import '../styles/hero.css'
import '../styles/usecases.css'
import '../styles/pricing.css'
import Navbar from '../component/Navbar.astro';
import Footer from '../component/Footer.astro';
import ContactUs from '../component/ContactUs.astro';
import Loader from '../component/Loader.astro';

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
import { graph, organizationSchema, websiteSchema, breadcrumb, ORG_ID, WEBSITE_ID, SITE } from '../utils/schema.js'

const contactSchema = graph([
  organizationSchema,
  websiteSchema,
  {
    '@type': 'ContactPage',
    '@id': `${SITE}/contact/#webpage`,
    url: `${SITE}/contact/`,
    name: 'Contact UnumPay | We Are Here to Help',
    description:
      'Get in touch with the UnumPay team for payment gateway support, integration help, or partnership inquiries. We respond within 24 business hours.',
    isPartOf: { '@id': WEBSITE_ID },
    about: { '@id': ORG_ID },
    breadcrumb: { '@id': `${SITE}/contact/#breadcrumb` },
    inLanguage: 'en',
  },
  breadcrumb([['Home', '/'], ['Contact', '/contact/']], '/contact/#breadcrumb'),
])

---


<Layout title="Contact UnumPay | We Are Here to Help"
  description="Get in touch with the UnumPay team for payment gateway support, integration help, or partnership inquiries. We respond within 24 business hours."
  schema={contactSchema}>

  <Loader />

	<Navbar />

	<ContactUs />

	<Footer />

</Layout>
