---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css'
import '../styles/hero.css'
import '../styles/usecases.css'
import '../styles/pricing.css'
import OurStory from '../components/OurStory';
import Navbar from '../component/Navbar.astro';
import Footer from '../component/Footer.astro';

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
import { graph, organizationSchema, websiteSchema, breadcrumb, ORG_ID, WEBSITE_ID, SITE } from '../utils/schema.js'

const ourStorySchema = graph([
  organizationSchema,
  websiteSchema,
  {
    '@type': 'AboutPage',
    '@id': `${SITE}/our-story/#webpage`,
    url: `${SITE}/our-story/`,
    name: 'Pioneering Shopify Payment Innovation Since 2016 | UnumPay',
    description:
      'Learn how UnumPay was built to solve real merchant payment challenges. From startup to 2500+ active merchants across 45+ countries.',
    isPartOf: { '@id': WEBSITE_ID },
    about: { '@id': ORG_ID },
    breadcrumb: { '@id': `${SITE}/our-story/#breadcrumb` },
    inLanguage: 'en',
  },
  breadcrumb([['Home', '/'], ['About Us', '/our-story/']], '/our-story/#breadcrumb'),
])

---


<Layout title="Pioneering Shopify Payment Innovation Since 2016 | UnumPay"
  description="Learn how UnumPay was built to solve real merchant payment challenges. From startup to 2500+ active merchants across 45+ countries."
  schema={ourStorySchema}>

	<Navbar />

    <OurStory client:load />

	<Footer />

</Layout>
