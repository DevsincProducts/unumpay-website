---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css'
import '../styles/coverage.css'
import '../styles/tunisia.css'
import '../styles/hero.css'
import '../styles/usecases.css'
import '../styles/pricing.css'
import GatewayGuide from '../components/Flouci.jsx';
import { gatewayGuides } from '../data/payments';
import { clampDescription } from '../utils/seo.js';
import Navbar from '../component/Navbar.astro';
import Footer from '../component/Footer.astro';
import Loader from '../component/Loader.astro';
import { graph, organizationSchema, websiteSchema, faqPage, breadcrumb, SITE } from '../utils/schema.js';
import fs from 'node:fs';

export async function getStaticPaths() {
  return gatewayGuides.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;

const pageTitle = `${entry.name} Integration Guide | UnumPay`;
// Gateways with a long region list pushed this past the ~160 characters a
// search result shows. Name the first two markets, summarise the rest, and
// clamp so a long gateway name can never blow the limit again.
const regions = entry.regions ?? [];
const regionText =
  regions.length > 2
    ? `${regions.slice(0, 2).join(', ')} and more`
    : regions.join(' and ');
const pageDescription = clampDescription(
  `Connect ${entry.name} to your Shopify store with UnumPay in ${entry.setupTime}. Step-by-step integration guide for merchants in ${regionText}.`
);

// Each guide has its own OG image on the live site; a couple don't, so fall
// back to the shared one rather than emitting a link to a 404.
const ogCandidate = `og-${entry.slug}.jpg`;
const ogImage = fs.existsSync(`public/${ogCandidate}`) ? `/${ogCandidate}` : '/opengraph.jpg';

// Step titles/descriptions contain a "{name}" placeholder that the UI swaps
// out at render time — the schema has to do the same or the rich result would
// show a literal "{name}" to searchers.
const fillName = (text = '') => text.replaceAll('{name}', entry.name);

const guideSchema = graph([
  organizationSchema,
  websiteSchema,
  {
    '@type': 'HowTo',
    '@id': `${SITE}/${entry.slug}/#howto`,
    name: `${entry.name} Integration Guide`,
    description: pageDescription,
    totalTime: 'PT5M',
    step: (entry.steps ?? []).map((s, i) => ({
      '@type': 'HowToStep',
      position: i + 1,
      name: fillName(s.title),
      text: fillName(s.description),
      url: `${SITE}/${entry.slug}/#step-${i + 1}`,
    })),
    supply: (entry.beforeYouBegin ?? []).map((item) => ({
      '@type': 'HowToSupply',
      name: item,
    })),
  },
  ...(entry.commonQuestions?.length
    ? [faqPage(entry.commonQuestions, `/${entry.slug}/#faq`)]
    : []),
  breadcrumb(
    [['Home', '/'], ['Coverage', '/coverage/'], [`${entry.name} Integration Guide`, `/${entry.slug}/`]],
    `/${entry.slug}/#breadcrumb`
  ),
]);
---

<Layout title={pageTitle}
  description={pageDescription}
  image={ogImage}
  imageAlt={`${entry.name} Integration Guide`}
  schema={guideSchema}>

  <Loader />

  <Navbar />

  <GatewayGuide data={entry} client:load />
  
  <Footer />

</Layout>