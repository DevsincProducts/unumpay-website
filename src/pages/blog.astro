---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css'
import '../styles/hero.css'
import '../styles/usecases.css'
import '../styles/pricing.css'
import Blogs from '../components/Blogs';
import '../styles/blogs.css'
import blogs from '../data/blogs.json';
import Navbar from '../component/Navbar.astro';
import Footer from '../component/Footer.astro';
import { formatDate, dateSortValue, readTimeFromBody } from '../utils/dates.js';

// ---- Single source of truth: src/data/blogs.json ----
// Naya blog add karne ke liye bas us JSON array mein ek object push karein.

const articles = [...blogs]
  .sort((a, b) => dateSortValue(b.date) - dateSortValue(a.date))
  .map((entry) => ({
    image: entry.image,
    category: entry.category,
    date: formatDate(entry.date),
    readTime: entry.readTime ?? readTimeFromBody(entry.body),
    title: entry.title,
    excerpt: entry.excerpt,
    slug: `/blog/${entry.slug}/`,
  }));

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
import { graph, organizationSchema, websiteSchema, breadcrumb, ORG_ID, WEBSITE_ID, SITE } from '../utils/schema.js'

const blogListSchema = graph([
  organizationSchema,
  websiteSchema,
  {
    '@type': 'Blog',
    '@id': `${SITE}/blog/#blog`,
    url: `${SITE}/blog/`,
    name: 'UnumPay Blog',
    description:
      'Expert guides, tutorials, and insights for Shopify merchants on local and global payment gateways.',
    publisher: { '@id': ORG_ID },
    isPartOf: { '@id': WEBSITE_ID },
    inLanguage: 'en',
    blogPost: articles.map((post) => ({
      '@type': 'BlogPosting',
      headline: post.title,
      url: `${SITE}/blog/${post.slug}/`,
      datePublished: post.date,
      author: { '@type': 'Person', name: post.author },
    })),
  },
  breadcrumb([['Home', '/'], ['Blog', '/blog/']], '/blog/#breadcrumb'),
])

---


<Layout title="Shopify Payment Guides and Insights | UnumPay Blog"
  description="Expert guides, tutorials, and insights for Shopify merchants on local and global payment gateways. Stay ahead with the latest payment trends and integration tips."
  schema={blogListSchema}>

	<Navbar />

	<Blogs client:load articles={articles} />

	<Footer />

</Layout>