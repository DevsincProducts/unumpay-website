---
import logo from '../assets/logos/logoe.svg'

const quickLinks = [
  { title: 'Home', href: '/' },
  { title: 'Coverage', href: '/coverage/' },
  { title: 'Pricing', href: '/pricing/' },
  { title: 'About Us', href: '/our-story/' },
  { title: 'Partners', href: '/become-a-partner/' },
]

const resourceLinks = [
  { title: 'Blog', href: '/blog/' },
  { title: 'FAQ', href: '/faq/' },
  { title: 'Contact', href: '/contact/' },
  { title: 'Privacy Policy', href: '/privacy-policy/' },
  { title: 'Reconciliation Setup', href: '/reconciliation-setup/' },
]

const regionsLinks = [
  { title: 'Tunisia', href: '/payment-gateways/tunisia/' },
  { title: 'South Africa', href: '/payment-gateways/south-africa/' },
]
---

<footer class="site-footer">
  <div class="footer-container">
    <div class="footer-grid">
      <!-- Brand column -->
      <div class="footer-brand">
        <a href="/" class="footer-logo">
          <img src={logo.src ?? logo} alt="UnumPay" class="footer-logo-img" loading="lazy" />
        </a>

        <p class="footer-desc">
          UnumPay is a Shopify payment gateway mediation platform connecting merchants to 40+ payment providers worldwide.
        </p>

        <div class="footer-contact">
          <a href="tel:+923000342357" class="footer-contact-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            +92 300 0342357
          </a>
          <a href="mailto:unumpay@devsinc.com" class="footer-contact-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            unumpay@devsinc.com
          </a>
        </div>

        <div class="footer-socials">
          <a href="https://www.instagram.com/unumpay/" target="_blank" rel="noopener noreferrer" class="footer-social-icon" aria-label="Instagram">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838a6 6 0 1 0 0 12 6 6 0 0 0 0-12zm0 9.838a3.838 3.838 0 1 1 0-7.676 3.838 3.838 0 0 1 0 7.676zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"></path>
            </svg>
          </a>
          <a href="https://www.linkedin.com/showcase/unumpay" target="_blank" rel="noopener noreferrer" class="footer-social-icon" aria-label="LinkedIn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zM7.114 20.452H3.558V9h3.556v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path>
            </svg>
          </a>
          <a href="https://www.facebook.com/unumpay" target="_blank" rel="noopener noreferrer" class="footer-social-icon" aria-label="Facebook">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M22.675 0h-21.35c-.732 0-1.325.593-1.325 1.325v21.351c0 .731.593 1.324 1.325 1.324h11.495v-9.294h-3.128v-3.622h3.128v-2.671c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.795.143v3.24l-1.918.001c-1.504 0-1.795.715-1.795 1.763v2.313h3.587l-.467 3.622h-3.12v9.293h6.116c.73 0 1.323-.593 1.323-1.325v-21.35c0-.732-.593-1.325-1.325-1.325z"></path>
            </svg>
          </a>
          <a href="https://wa.me/923000342357" target="_blank" rel="noopener noreferrer" class="footer-social-icon" aria-label="WhatsApp">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.198.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.29.173-1.414-.074-.124-.272-.198-.57-.347z"></path>
              <path d="M12.004 2C6.486 2 2.004 6.482 2.004 12c0 1.85.505 3.58 1.384 5.06L2 22l5.062-1.362A9.96 9.96 0 0 0 12.004 22c5.518 0 10-4.482 10-10s-4.482-10-10-10zm0 18.2a8.17 8.17 0 0 1-4.166-1.14l-.298-.177-3.104.835.833-3.023-.194-.31A8.19 8.19 0 0 1 3.804 12c0-4.522 3.678-8.2 8.2-8.2 4.523 0 8.2 3.678 8.2 8.2 0 4.522-3.677 8.2-8.2 8.2z"></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <div class="footer-col">
        <h4 class="footer-col-title">QUICK LINKS</h4>
        <ul class="footer-link-list">
          {quickLinks.map((link) => (
            <li>
              <a href={link.href} class="footer-link">
                {link.title}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Resources -->
      <div class="footer-col">
        <h4 class="footer-col-title">RESOURCES</h4>
        <ul class="footer-link-list">
          {resourceLinks.map((link) => (
            <li>
              <a href={link.href} class="footer-link">
                {link.title}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="footer-col">
        <h4 class="footer-col-title">REIGONS</h4>
        <ul class="footer-link-list">
          {regionsLinks.map((link) => (
            <li>
              <a href={link.href} class="footer-link">
                {link.title}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Get Started -->
      <!-- <div class="footer-col footer-cta-col">
        <h4 class="footer-col-title">GET STARTED</h4>
        <p class="footer-cta-desc">
          Connect your Shopify store to 40+ payment gateways. Free to install, no monthly fees.
        </p>

        <a
          href="https://apps.shopify.com/unum-pay"
          target="_blank"
          rel="noopener noreferrer"
          class="footer-cta-btn"
        >
          Install on Shopify
        </a>

        <div class="footer-rating">
          <div class="footer-stars">★★★★★</div>
          <span class="footer-rating-text">4.6 · Shopify App Store</span>
        </div>
      </div> -->
    </div>

    <div class="footer-bottom">
      <p class="footer-copyright">© 2026 UnumPay — Powered by Devsinc.</p>
      <div class="footer-bottom-links">
        <a href="/privacy-policy" class="footer-bottom-link">Privacy Policy</a>
        <a href="/terms-of-use" class="footer-bottom-link">Terms of Use</a>
        <a href="/contact" class="footer-bottom-link">Support</a>
      </div>
    </div>
  </div>
</footer>