<script>
document.addEventListener('astro:page-load', () => {
// Re-runs on every client-side navigation — drop the previous run's timer
// and window-level listener first so they don't pile up.
if (window.__testimonialIntervalId) clearInterval(window.__testimonialIntervalId)
if (window.__testimonialAbort) window.__testimonialAbort.abort()
const testimonialAbort = new AbortController()
window.__testimonialAbort = testimonialAbort
const { signal } = testimonialAbort

const AUTO_SLIDE_INTERVAL = 3500

const carousel = document.getElementById('testimonial-carousel') as HTMLElement | null
const prevBtn = document.getElementById('testimonial-prev') as HTMLButtonElement | null
const nextBtn = document.getElementById('testimonial-next') as HTMLButtonElement | null
const dotsContainer = document.getElementById('testimonial-dots') as HTMLElement | null
const grid = document.getElementById('testimonial-grid') as HTMLElement | null
const cards = grid ? Array.from(grid.querySelectorAll<HTMLElement>('.testimonial-card')) : []

let itemsPerPage = getItemsPerPage()
let currentPage = 0
let isPaused = false
let intervalId: ReturnType<typeof setInterval> | null = null

function getItemsPerPage() {
  const w = window.innerWidth
  if (w <= 768) return 1
  if (w <= 1024) return 2
  return 3
}

function totalPages() {
  return Math.ceil(cards.length / itemsPerPage)
}

function renderDots() {
  if (!dotsContainer) return
  dotsContainer.innerHTML = ''
  for (let i = 0; i < totalPages(); i++) {
    const dot = document.createElement('button')
    dot.className = 'testimonial-dot' + (i === currentPage ? ' testimonial-dot--active' : '')
    dot.dataset.page = String(i)
    dot.setAttribute('aria-label', `Go to page ${i + 1}`)
    dot.addEventListener('click', () => {
      showPage(i)
      restartInterval()
    })
    dotsContainer.appendChild(dot)
  }
}

function showPage(index: number) {
  const total = totalPages()
  currentPage = (index + total) % total
  const start = currentPage * itemsPerPage
  const end = start + itemsPerPage
  cards.forEach((card, i) => {
    card.style.display = i >= start && i < end ? '' : 'none'
  })
  const dots = dotsContainer ? Array.from(dotsContainer.querySelectorAll<HTMLButtonElement>('.testimonial-dot')) : []
  dots.forEach((dot, i) => dot.classList.toggle('testimonial-dot--active', i === currentPage))
}

function goPrev() {
  showPage(currentPage - 1)
  restartInterval()
}

function goNext() {
  showPage(currentPage + 1)
  restartInterval()
}

function startInterval() {
  if (isPaused || totalPages() <= 1) return
  intervalId = setInterval(() => showPage(currentPage + 1), AUTO_SLIDE_INTERVAL)
  window.__testimonialIntervalId = intervalId
}

function stopInterval() {
  if (intervalId) {
    clearInterval(intervalId)
    intervalId = null
  }
}

function restartInterval() {
  stopInterval()
  startInterval()
}

function handleResize() {
  const newItemsPerPage = getItemsPerPage()
  if (newItemsPerPage !== itemsPerPage) {
    itemsPerPage = newItemsPerPage
    currentPage = 0
    renderDots()
    showPage(0)
    restartInterval()
  }
}

prevBtn?.addEventListener('click', goPrev)
nextBtn?.addEventListener('click', goNext)

// Hovering an arrow advances immediately — no click needed. Auto-slide
// keeps running independently (goPrev/goNext already restart its timer).
prevBtn?.addEventListener('mouseenter', goPrev)
nextBtn?.addEventListener('mouseenter', goNext)

window.addEventListener('resize', handleResize, { signal })

carousel?.addEventListener('mouseenter', () => {
  isPaused = true
  stopInterval()
})

carousel?.addEventListener('mouseleave', () => {
  isPaused = false
  startInterval()
})

renderDots()
showPage(0)
startInterval()
})
</script>