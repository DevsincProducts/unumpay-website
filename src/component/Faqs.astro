---
import FaqGlobeHero from '../components/FaqGlobeHero.jsx'
import FaqAccordion from '../components/FaqAccordion.jsx'
import { faqData } from '../data/faqs.js'
---

<FaqGlobeHero
  client:load
  title="Frequently Asked Questions"
  subtitle="Everything you need to know about setting up and running UnumPay."
/>

<section class="unumpay-faq-section">
  <div class="unumpay-faq-container">
    <FaqAccordion client:visible items={faqData} columns={2} />
  </div>
</section>

<section class="unumpay-help-section">
  <div
    class="unumpay-help-wrapper"
  >
    <div class="unumpay-help-card">
      <h3 class="unumpay-help-title">Still Have Questions?</h3>
      <p class="unumpay-help-text">
        Our support team is here to help you get integrated quickly.
      </p>
      <a href="/contact/" class="unumpay-help-cta">
        Contact Support
      </a>
    </div>
  </div>
</section>
