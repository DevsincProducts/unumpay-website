---
// Preference.astro
---

<section class="cta-section js-fade-scroll" data-direction="up">
  <div class="cta-section__glow" aria-hidden="true"></div>

  <div class="cta-content">
    <span class="cta-badge">✦ Shopify Approved App</span>

    <div class="cta-heading">
      Ready to Accept Every Payment Your Customers Prefer?
    </div>

    <div class="cta-subtitle">
      Join 2,500+ Shopify merchants already using UnumPay. Free to install. No credit card. No developer required.
    </div>

    <div class="cta-actions">
      <a href="https://apps.shopify.com/unum-pay" target="_blank" rel="noopener noreferrer" class="cta-section__btn-primary">
        Install on Shopify <span aria-hidden="true">→</span>
      </a>
      <a href="/contact" class="cta-section__btn-secondary">
        Contact Our Team <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>