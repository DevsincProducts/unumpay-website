---
import FaqGlobeHero from '../components/FaqGlobeHero.jsx'
import FaqAccordion from '../components/FaqAccordion.jsx'

const features = [
  'Multiple Payment Gateways',
  'Multi-Currency Payment Acceptance',
  'All-in-One Dashboard',
  'Reconciliation Reports',
  'Advance Payment',
  'Round Off Amount',
  'Custom % Surcharge on Checkout',
]

const comparisonRows = [
  { feature: 'Setup Fee', value: 'Free' },
  { feature: 'Monthly Fee', value: 'None' },
  { feature: 'Per Transaction', value: '0.85%' },
  { feature: 'Multiple Gateways', value: 'One integration' },
  { feature: 'Unified Dashboard', value: 'One dashboard' },
  { feature: 'Shopify Approved', value: 'Yes' },
  { feature: 'Setup Time', value: 'Under 5 minutes' },
]

const faqs = [
  {
    question: 'Are there any hidden fees?',
    answer: 'No. UnumPay has no setup fee, no monthly subscription, and no hidden charges. You pay only 0.85% per successful transaction.',
  },
  {
    question: 'How will I be charged?',
    answer: 'UnumPay charges 0.85% on each successful transaction processed through your connected gateways. There is no upfront or recurring fee. Charges apply only when a sale completes.',
  },
  {
    question: 'What counts as a successful transaction?',
    answer: 'A successful transaction is a completed payment where funds are captured through a connected gateway. Failed, declined, or abandoned checkouts are not charged.',
  },
  {
    question: 'Do I need to pay extra for multiple gateways?',
    answer: 'No. The 0.85% per-transaction rate covers connecting and running multiple payment gateways through one UnumPay integration. There is no additional fee per gateway.',
  },
  {
    question: 'Is there a free trial?',
    answer: 'UnumPay is free to install and you pay nothing until your first successful sale. Because there is no monthly fee, you only ever pay the 0.85% per-transaction rate when you actually process a payment.',
  },
]
---

<div>
  <section class="pri-section js-fade-scroll" data-direction="up">
    <div class="cta-section__glow" aria-hidden="true"></div>
    <div class="pri-content">
      <span class="pri-badge">✦ Transparent Pricing</span>

      <h1 class="pri-heading" >
        Simple Pricing. No Surprises.
      </h1>

      <div class="pri-subtitle" >
        One straightforward fee per successful transaction. No setup costs. No monthly subscriptions. No hidden charges.
      </div>
    </div>
  </section>

  <section class="pri-compare-section js-fade-scroll" data-direction="up">
    <div class="pri-compare-container">
      <!-- Left: Pricing card -->
      <div
        class="pri-card js-fade-scroll"
        data-direction="left"
        style="--x-offset: 40px;"
        data-duration="0.7"
        data-delay="0"
        data-amount="0.2"
      >
        <div class="pri-card__accent"></div>
        <div class="pri-card__body">
          <span class="pri-card__badge">UNUMPAY STANDARD</span>

          <h3 class="pri-card__rate">0.85%</h3>
          <p class="pri-card__rate-label">per successful transaction</p>

          <hr class="pri-card__divider" />

          <ul class="pri-card__features">
            {features.map((feature) => (
              <li class="pri-card__feature-item">
                <span class="pri-card__check">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </span>
                {feature}
              </li>
            ))}
          </ul>

          <a href="https://apps.shopify.com/unum-pay" target="_blank" rel="noopener noreferrer" class="pri-card__cta">
            Install on Shopify <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <!-- Right: Comparison table -->
      <div
        class="pri-compare-content js-fade-scroll"
        data-direction="right"
        style="--x-offset: 40px;"
        data-duration="0.7"
        data-delay="0"
        data-amount="0.2"
      >
        <h2 class="pri-compare-heading">Why Merchants Choose UnumPay</h2>

        <div class="pri-table">
          <div class="pri-table__header">
            <span>Feature</span>
            <p>UnumPay</p>
          </div>

          {comparisonRows.map((row, index) => (
            <div class={`pri-table__row ${index % 2 === 1 ? 'pri-table__row--alt' : ''}`}>
              <span class="pri-table__feature">{row.feature}</span>
              <span class="pri-table__value">
                <svg class="pri-table__check-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                {row.value}
              </span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <FaqGlobeHero
    client:visible={{ rootMargin: '200px' }}
    compact
    title="FAQ"
    subtitle="Everything you need to know about UnumPay's pay-as-you-go pricing."
  />

  <section class="faq-section js-fade-scroll" data-direction="up" data-duration="0.45" data-amount="0">
    <div class="faq-container">
      <FaqAccordion client:visible items={faqs} columns={2} />
    </div>
  </section>

  <section class="pree-section js-fade-scroll" data-direction="up">
    <div class="cta-section__glow" aria-hidden="true"></div>
    <div class="pri-content" >
      <div class="pri-sec-heading" data-direction="up" style="--y-offset: 40px;" data-duration="0.7" data-delay="0.1" data-amount="0.2">
        Start Accepting Payments Today.
      </div>

      <div class="pri-sec-subtitle">
        Pay nothing until you make your first sale.
      </div>

      <div class="cta-actions" >
        <a href="https://apps.shopify.com/unum-pay" target="_blank" rel="noopener noreferrer" class="cta-section__btn-primary">
          Install on Shopify <span aria-hidden="true">→</span>
        </a>
        <a href="/contact" class="cta-section__btn-secondary">
          Contact Our Team <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>
</div>

<script>
  import { initFadeIn } from '../scripts/Animation'

  document.addEventListener('astro:page-load', () => {
    initFadeIn()
  })
</script>