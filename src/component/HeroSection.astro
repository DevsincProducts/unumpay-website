---

import HeroImg from '../assets/images/image1.webp'
import HeroImgMobile from '../assets/images/image1-mobile.webp'
import HeroImgSmall from '../assets/images/image1-mobile-sm.webp'
import logo1 from '../assets/logos/logo1.webp'
import logo2 from '../assets/logos/logo2.webp'
import logo3 from '../assets/logos/logo3.webp'
import logo4 from '../assets/logos/logo4.webp'
import logo5 from '../assets/logos/logo5.webp'
import logo6 from '../assets/logos/logo6.webp'
import logo7 from '../assets/logos/logo7.webp'
import logo8 from '../assets/logos/logo8.webp'
import logo9 from '../assets/logos/logo9.webp'
import logo10 from '../assets/logos/logo10.webp'

// Named so the alt text says which merchant each logo actually shows, instead
// of "Brand logo 1..20". These are the brands using UnumPay.
//
// Astro's image import already returns an object ({src, width, height}), not
// a plain URL string — the field here is called `img` (not `src`) so
// `logo.img.src` stays unambiguous rather than shadowing that object's own
// `.src` property.
const logos = [
  { img: logo1, name: 'Outfitters' },
  { img: logo2, name: 'Nishat Linen' },
  { img: logo3, name: 'Xiaomi' },
  { img: logo4, name: 'Stylo' },
  { img: logo5, name: 'Bata' },
  { img: logo6, name: 'Minnie Minors' },
  { img: logo7, name: 'Ammara Khan' },
  { img: logo8, name: 'Jenpharm Life Sciences' },
  { img: logo9, name: 'Interwood' },
  { img: logo10, name: 'Nida Azwer Atelier' },
]
// Doubled purely so the marquee can loop without a visible seam.
const marqueeLogos = [...logos, ...logos]
---

<section class="homepage-section">
  <div class="hero-home relative overflow-hidden">
    <div class="hero-home__grid relative z-10">
      <!-- Left content -->
      <div class="hero-home__text">
        <span class="hero-home__badge">✦ Shopify Approved App</span>

        <div>
          <h1 class="hero-home__title">
            Simplify Your <br />
            Shopify <span class="hero-home__title-accent">Payments</span>
          </h1>
        </div>

        <div>
          <p class="hero-home__subheadline">
            Access <span class="hero-home__subheadline-bold">40+ Payment Gateways</span> for your e-commerce
            store to sell globally. Manage, monitor, and analyze all your transaction data in one place.
          </p>
        </div>

        <div>
          <div class="hero-home__actions">
            <a
              href="https://apps.shopify.com/unum-pay"
              target="_blank"
              rel="noopener noreferrer"
              class="hero-home__primary-cta"
            >
              Get Started <span aria-hidden="true">→</span>
            </a>
            <a
              href="#how-it-works"
              class="hero-home__ghost-cta"
              id="how-it-works-link"
            >
              How It Works <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Right section -->
      <div class="hero-home__graphic">
        <img
          src={HeroImg.src ?? HeroImg}
          srcset={`${HeroImgSmall.src ?? HeroImgSmall} 480w, ${HeroImgMobile.src ?? HeroImgMobile} 750w, ${HeroImg.src ?? HeroImg} 1300w`}
          sizes="(min-width: 1024px) 600px, 90vw"
          alt="UnumPay integration diagram"
          class="w-full max-w-2xl h-auto animate-float"
          fetchpriority="high"
        />
      </div>
    </div>

    <div class="hero-home__marquee-section">
      <p class="marquee-heading">TRUSTED BY 2,500+ GLOBAL MERCHANTS</p>

      <!-- Logos -->
      <div class="marquee-wrapper">
        <div class="marquee-track">
          <div class="marquee-content animate-marquee">
            {marqueeLogos.map((logo, index) => (
              <div class="marquee-logo" aria-hidden={index >= logos.length ? 'true' : undefined}>
                <img
                  src={logo.img.src}
                  alt={index >= logos.length ? '' : `${logo.name} logo`}
                  class="h-8 w-auto object-contain"
                />
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
  .animate-marquee {
    animation: marquee 30s linear infinite;
  }
  .marquee-wrapper:hover .animate-marquee {
    animation-play-state: paused;
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-18px);
    }
  }
  .animate-float {
    animation: float 4s ease-in-out infinite;
  }
</style>

<script>
  import { initFadeIn } from '../scripts/Animation'

  document.addEventListener('astro:page-load', () => {
    const howItWorksLink = document.getElementById('how-it-works-link')

    howItWorksLink?.addEventListener('click', (e) => {
      e.preventDefault()
      const target = document.getElementById('how-it-works')
      if (target) {
        target.scrollIntoView({ behavior: 'smooth', block: 'start' })
      }
    })

    initFadeIn()
  })
</script>