---

const PARTNERSHIP_TYPES = [
  { value: 'Payment Service Provider (PSP)', label: 'Payment Service Provider (PSP)' },
  { value: 'Shopify Agency', label: 'Shopify Agency' },
  { value: 'Bank or Financial Institution', label: 'Bank or Financial Institution' },
  { value: 'Affiliate Partner', label: 'Affiliate Partner' },
  { value: 'Other', label: 'Other' },
]
---

<div>
  <section class="pri-section js-fade-scroll" data-direction="up">
    <div class="cta-section__glow" aria-hidden="true"></div>
    <div class="pri-content">
      <span class="pri-badge">✦ Partner with UnumPay</span>

      <h1 class="pri-heading" >
        Grow Together with UnumPay.
      </h1>

      <div class="pri-subtitle">
        Join our partner network and reach thousands of Shopify merchants across 45+ countries.
      </div>
    </div>
  </section>

  <section class="pri-partner-section js-fade-scroll" data-direction="up">
    <h2 class="pri-partner-heading">Choose Your Partnership Type</h2>

    <div class="pri-partner-container">
      <!-- Payment Partner Card -->
      <div class="pri-partner-card js-fade-scroll" data-direction="left" style="--x-offset: 40px;" data-duration="0.7" data-delay="0" data-amount="0.2">
        <div class="pri-partner-card__icon">💳</div>

        <h3 class="pri-partner-card__title">Payment Partner Program</h3>

        <p class="pri-partner-card__desc">
          If you operate a payment gateway and want to reach thousands of Shopify merchants across 45+ countries, list your gateway on UnumPay and grow your transaction volume.
        </p>

        <div class="pri-partner-card__features">
          <div class="pri-partner-card__feature-item">
            <span class="pri-partner-card__check">✓</span> Direct integration on UnumPay
          </div>
          <div class="pri-partner-card__feature-item">
            <span class="pri-partner-card__check">✓</span> Reach 45+ country merchants
          </div>
          <div class="pri-partner-card__feature-item">
            <span class="pri-partner-card__check">✓</span> Zero upfront listing cost
          </div>
          <div class="pri-partner-card__feature-item">
            <span class="pri-partner-card__check">✓</span> Co-marketing opportunities
          </div>
        </div>

        <button type="button" class="pri-partner-card__cta" data-open-modal="payment">
          Become a Payment Partner <span aria-hidden="true">→</span>
        </button>
      </div>

      <!-- Agency Partner Card -->
      <div class="pri-partner-card js-fade-scroll" data-direction="right" style="--x-offset: 40px;" data-duration="0.7" data-delay="0" data-amount="0.2">
        <div class="pri-partner-card__icon">🏢</div>

        <h3 class="pri-partner-card__title">Agency Partner Program</h3>

        <p class="pri-partner-card__desc">
          Shopify agencies, developers, and consultants — refer your clients to UnumPay and earn recurring commissions while delivering a best-in-class payment solution.
        </p>

        <div class="pri-partner-card__features">
          <div class="pri-partner-card__feature-item">
            <span class="pri-partner-card__check">✓</span> Recurring referral commissions
          </div>
          <div class="pri-partner-card__feature-item">
            <span class="pri-partner-card__check">✓</span> Dedicated partner support
          </div>
          <div class="pri-partner-card__feature-item">
            <span class="pri-partner-card__check">✓</span> White-label friendly
          </div>
          <div class="pri-partner-card__feature-item">
            <span class="pri-partner-card__check">✓</span> Priority onboarding for clients
          </div>
        </div>

        <button type="button" class="pri-partner-card__cta" data-open-modal="agency">
          Become an Agency Partner <span aria-hidden="true">→</span>
        </button>
      </div>
    </div>
  </section>

  <section class="pree-section js-fade-scroll" data-direction="up">
    <div class="cta-section__glow" aria-hidden="true"></div>
    <div class="pri-content">
      <div class="pri-sec-heading">
        Already a Partner?
      </div>

      <div class="pri-sec-subtitle">
        Access your partner portal or explore the latest resources, guides, and updates.
      </div>

      <div class="cta-actions">
        <a href="/contact" class="cta-section__btn-primary">
          Access Partner Portal <span aria-hidden="true">→</span>
        </a>
        <a href="/blog/" class="cta-section__btn-secondary">
          View Partner Resources <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Partner Modal (single reusable instance, hidden by default) -->
  <div class="partner-modal-overlay" id="partner-modal-overlay" style="display: none;">
    <div class="partner-modal" id="partner-modal">
      <button type="button" class="partner-modal__close" id="partner-modal-close" aria-label="Close">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>

      <!-- Success view -->
      <div class="partner-modal__success" id="partner-modal-success" style="display: none;">
        <div class="partner-modal__success-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </div>
        <h3 class="partner-modal__success-title">Application Received!</h3>
        <p class="partner-modal__success-text">
          Thank you! We'll be in touch within 2 business days.
        </p>
        <button type="button" class="partner-modal__success-close" id="partner-modal-success-close">
          Close
        </button>
      </div>

      <!-- Form view -->
      <div id="partner-modal-form-wrapper">
        <h3 class="partner-modal__title" id="partner-modal-title">Become a Payment Partner</h3>
        <p class="partner-modal__subtitle">
          Fill in the details below and we'll get back to you within 2 business days.
        </p>

        <form class="partner-modal__form" id="partner-modal-form">
          <div class="partner-modal__row">
            <div class="partner-modal__field">
              <label class="partner-modal__label">
                First Name <span class="partner-modal__required">*</span>
              </label>
              <input type="text" class="partner-modal__input" id="partner-first-name" placeholder="John" required />
            </div>
            <div class="partner-modal__field">
              <label class="partner-modal__label">
                Last Name <span class="partner-modal__required">*</span>
              </label>
              <input type="text" class="partner-modal__input" id="partner-last-name" placeholder="Smith" required />
            </div>
          </div>

          <div class="partner-modal__field">
            <label class="partner-modal__label">
              Work Email <span class="partner-modal__required">*</span>
            </label>
            <input type="email" class="partner-modal__input" id="partner-email" placeholder="john@company.com" required />
          </div>

          <div class="partner-modal__field">
            <label class="partner-modal__label">
              Partnership Type <span class="partner-modal__required">*</span>
            </label>
            <select class="partner-modal__select" id="partner-type" required>
              <option value="" disabled>Select partnership type</option>
              {PARTNERSHIP_TYPES.map((opt) => (
                <option value={opt.value}>{opt.label}</option>
              ))}
            </select>
          </div>

          <div class="partner-modal__field">
            <label class="partner-modal__label">
              Tell us about your company <span class="partner-modal__required">*</span>
            </label>
            <textarea
              class="partner-modal__textarea"
              id="partner-message"
              placeholder="Brief description of your company, what you do, and how you'd like to partner with UnumPay..."
              required
            ></textarea>
          </div>

          <p id="partner-modal-error" style="color: #ef4444; font-size: 14px; text-align: center; margin: 0; display: none;"></p>

          <button type="submit" class="partner-modal__submit" id="partner-modal-submit">
            <span id="partner-submit-label">Submit Application <span aria-hidden="true">→</span></span>
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  import { initFadeIn } from '../scripts/Animation'

  document.addEventListener('astro:page-load', () => {
  const WEB3FORMS_ACCESS_KEY = '772938fc-9d4d-4af9-91f7-08e83f67688f'

  const overlay = document.getElementById('partner-modal-overlay') as HTMLElement | null
  const modal = document.getElementById('partner-modal') as HTMLElement | null
  const closeBtn = document.getElementById('partner-modal-close') as HTMLButtonElement | null
  const successCloseBtn = document.getElementById('partner-modal-success-close') as HTMLButtonElement | null
  const successView = document.getElementById('partner-modal-success') as HTMLElement | null
  const formWrapper = document.getElementById('partner-modal-form-wrapper') as HTMLElement | null
  const form = document.getElementById('partner-modal-form') as HTMLFormElement | null
  const titleEl = document.getElementById('partner-modal-title') as HTMLElement | null
  const errorEl = document.getElementById('partner-modal-error') as HTMLElement | null
  const submitBtn = document.getElementById('partner-modal-submit') as HTMLButtonElement | null
  const submitLabel = document.getElementById('partner-submit-label') as HTMLElement | null

  const firstNameInput = document.getElementById('partner-first-name') as HTMLInputElement | null
  const lastNameInput = document.getElementById('partner-last-name') as HTMLInputElement | null
  const emailInput = document.getElementById('partner-email') as HTMLInputElement | null
  const typeSelect = document.getElementById('partner-type') as HTMLSelectElement | null
  const messageTextarea = document.getElementById('partner-message') as HTMLTextAreaElement | null

  let currentType: 'payment' | 'agency' = 'payment'

  function resetModal() {
    form?.reset()
    if (errorEl) {
      errorEl.style.display = 'none'
      errorEl.textContent = ''
    }
    if (successView) successView.style.display = 'none'
    if (formWrapper) formWrapper.style.display = ''
    setSubmitting(false)
  }

  function openModal(type: 'payment' | 'agency') {
    currentType = type
    resetModal()

    if (titleEl) {
      titleEl.textContent = type === 'agency' ? 'Become an Agency Partner' : 'Become a Payment Partner'
    }
    if (typeSelect) {
      typeSelect.value = type === 'agency' ? 'Shopify Agency' : 'Payment Service Provider (PSP)'
    }

    if (overlay) overlay.style.display = 'flex'
  }

  function closeModal() {
    if (overlay) overlay.style.display = 'none'
  }

  function setSubmitting(isSubmitting: boolean) {
    if (submitBtn) submitBtn.disabled = isSubmitting
    if (submitLabel) {
      submitLabel.textContent = isSubmitting ? 'Submitting...' : ''
      if (!isSubmitting) {
        submitLabel.innerHTML = 'Submit Application <span aria-hidden="true">→</span>'
      }
    }
  }

  // Open modal buttons
  document.querySelectorAll<HTMLButtonElement>('[data-open-modal]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const type = btn.dataset.openModal === 'agency' ? 'agency' : 'payment'
      openModal(type)
    })
  })

  // Close interactions
  closeBtn?.addEventListener('click', closeModal)
  successCloseBtn?.addEventListener('click', closeModal)

  overlay?.addEventListener('click', (e) => {
    if (e.target === overlay) closeModal()
  })

  modal?.addEventListener('click', (e) => {
    e.stopPropagation()
  })

  // Form submission
  form?.addEventListener('submit', async (e) => {
    e.preventDefault()

    if (errorEl) {
      errorEl.style.display = 'none'
      errorEl.textContent = ''
    }
    setSubmitting(true)

    const firstName = firstNameInput?.value ?? ''
    const lastName = lastNameInput?.value ?? ''
    const fullName = `${firstName} ${lastName}`.trim()

    try {
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          access_key: WEB3FORMS_ACCESS_KEY,
          from_name: 'UnumPay Website',
          to_email: 'unumpay@devsinc.com',
          subject: `New ${currentType === 'agency' ? 'Agency' : 'Payment'} Partner Application — ${fullName}`,
          first_name: firstName,
          last_name: lastName,
          work_email: emailInput?.value ?? '',
          partnership_type: typeSelect?.value ?? '',
          about_company: messageTextarea?.value ?? '',
        }),
      })

      const result = await response.json()

      if (result.success) {
        if (formWrapper) formWrapper.style.display = 'none'
        if (successView) successView.style.display = ''
      } else if (errorEl) {
        errorEl.textContent = 'Something went wrong. Please try again.'
        errorEl.style.display = ''
      }
    } catch (err) {
      if (errorEl) {
        errorEl.textContent = 'Something went wrong. Please try again.'
        errorEl.style.display = ''
      }
    } finally {
      setSubmitting(false)
    }
  })

  initFadeIn()
  })
</script>