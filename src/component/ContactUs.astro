---
const helpCards = [
  {
    icon: '⚡',
    title: 'Fast Response',
    desc: 'We reply within 24 hours on business days',
  },
  {
    icon: '🌍',
    title: 'Global Support',
    desc: 'Supporting merchants in every corner of the world',
  },
  {
    icon: '🛍️',
    title: 'Shopify Experts',
    desc: 'Dedicated team with deep Shopify payment expertise',
  },
]
---

<div>
  <section class="pri-section js-fade-scroll" data-direction="up">
    <div class="cta-section__glow" aria-hidden="true"></div>
    <div class="pri-content">
      <h1 class="pri-heading">
        Let's Talk.
      </h1>
      <div class="pri-subtitle">
        Have a question about UnumPay? Want to request a gateway? Our team is here.
      </div>
    </div>
  </section>

  <section class="contact-form-section js-fade-scroll" data-direction="up">
    <div class="contact-grid">

      <!-- Form column -->
      <div>
        <!-- Success view -->
        <div
          id="contact-success-view"
          class="bg-purple-50 rounded-3xl flex flex-col items-center justify-center text-center"
          style="padding: 80px 40px; display: none;"
        >
          <div
            class="w-16 h-16 rounded-full flex items-center justify-center mb-6"
            style="background: linear-gradient(135deg, rgb(200, 18, 213), rgb(106, 3, 206));"
          >
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </div>

          <h3 class="text-base font-bold text-[#171721] mb-2">Message Sent!</h3>

          <p class="text-gray-400 text-[13px] mb-2">
            We've received your message and will get back to you shortly.
          </p>

          <button
            type="button"
            id="contact-send-another"
            class="text-purple-600 font-semibold text-[13px] transition-colors hover:text-purple-700 active:text-purple-800 focus-visible:outline-2 focus-visible:outline-purple-600 focus-visible:outline-offset-2 rounded"
          >
            Send another message
          </button>
        </div>

        <!-- Form view -->
        <div id="contact-form-wrapper">
          <form id="contact-form" class="flex flex-col gap-3">

            <input type="text" name="fullName" id="contact-fullName" placeholder="Full Name" required class="contact-form-input" />

            <input type="text" name="companyName" id="contact-companyName" placeholder="Company Name" class="contact-form-input" />

            <input type="email" name="email" id="contact-email" placeholder="Email Address" required class="contact-form-input" />

            <input type="tel" name="contactNumber" id="contact-contactNumber" placeholder="Contact Number" class="contact-form-input" />

            <input type="text" name="storeUrl" id="contact-storeUrl" placeholder="Shopify Store URL" class="contact-form-input" />

            <div class="relative w-full">
              <select name="subject" id="contact-subject" required class="contact-form-select">
                <option value="" disabled selected>Select a Subject</option>
                <option value="General Inquiry">General Inquiry</option>
                <option value="Gateway Request">Gateway Request</option>
                <option value="Technical Support">Technical Support</option>
                <option value="Partnership">Partnership</option>
                <option value="Other">Other</option>
              </select>
              <span class="contact-select-icon">▼</span>
            </div>

            <textarea name="message" id="contact-message" placeholder="Your message..." rows="5" required class="contact-form-textarea"></textarea>

            <p id="contact-error" class="text-red-500 text-sm text-center" style="display: none;"></p>

            <button
              type="submit"
              id="contact-submit"
              class="w-full text-white font-semibold text-[16px] py-3.5 rounded-xl transition-all hover:-translate-y-0.5 hover:opacity-90 active:translate-y-0 active:opacity-100 disabled:opacity-60 disabled:cursor-not-allowed disabled:hover:translate-y-0 focus-visible:outline-2 focus-visible:outline-white focus-visible:outline-offset-2"
              style="background: linear-gradient(135deg, rgb(200, 18, 213), rgb(106, 3, 206));"
            >
              <span id="contact-submit-label">Send Message <span aria-hidden="true">→</span></span>
            </button>

            <p class="text-center text-gray-400 text-[13px] mt-1 font-normal">
              We typically respond within 24 business hours.
            </p>
          </form>
        </div>
      </div>

      <!-- Help column -->
      <div class="contact-help-panel">
        <h2 class="contact-help-heading">We're Here to Help</h2>

        <div class="help-cards-grid">
          {helpCards.map((card) => (
            <div class="help-card">
              <div class="help-card__icon">{card.icon}</div>
              <div class="help-card__title">{card.title}</div>
              <div class="help-card__desc">{card.desc}</div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>
</div>

<script>
  import { initFadeIn } from '../scripts/Animation'

  document.addEventListener('astro:page-load', () => {
  const form = document.getElementById('contact-form')
  const formWrapper = document.getElementById('contact-form-wrapper')
  const successView = document.getElementById('contact-success-view')
  const sendAnotherBtn = document.getElementById('contact-send-another')
  const errorEl = document.getElementById('contact-error')
  const submitBtn = document.getElementById('contact-submit')
  const submitLabel = document.getElementById('contact-submit-label')

  function setSubmitting(isSubmitting) {
    if (submitBtn) submitBtn.disabled = isSubmitting
    if (submitLabel) {
      submitLabel.innerHTML = isSubmitting
        ? 'Sending...'
        : 'Send Message <span aria-hidden="true">→</span>'
    }
  }

  function showError(message: string) {
    if (errorEl) {
      errorEl.textContent = message
      errorEl.style.display = ''
    }
  }

  function clearError() {
    if (errorEl) {
      errorEl.style.display = 'none'
      errorEl.textContent = ''
    }
  }

  function showSuccess() {
    if (formWrapper) formWrapper.style.display = 'none'
    if (successView) successView.style.display = ''
  }

  function resetToForm() {
    form?.reset()
    clearError()
    if (successView) successView.style.display = 'none'
    if (formWrapper) formWrapper.style.display = ''
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault()
    clearError()
    setSubmitting(true)

    const getValue = (id: string) => (document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null)?.value ?? ''

    try {
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          access_key: '772938fc-9d4d-4af9-91f7-08e83f67688f',
          name: getValue('contact-fullName'),
          company: getValue('contact-companyName'),
          email: getValue('contact-email'),
          phone: getValue('contact-contactNumber'),
          shopify_url: getValue('contact-storeUrl'),
          inquiry_subject: getValue('contact-subject'),
          message: getValue('contact-message'),
          from_name: 'UnumPay Website',
          subject: 'New Contact Form Submission – UnumPay Website',
        }),
      })

      const result = await response.json()

      if (result.success) {
        showSuccess()
      } else {
        showError('Something went wrong. Please try again.')
      }
    } catch (err) {
      showError('Something went wrong. Please try again.')
    } finally {
      setSubmitting(false)
    }
  })

  sendAnotherBtn?.addEventListener('click', resetToForm)

  initFadeIn()
  })
</script>