---

const privacySections = [
  {
    title: '1. Acceptance of Terms',
    content: 'By installing, accessing, or using UnumPay you agree to be bound by these Terms of Use. If you do not agree do not use the Service. UnumPay is operated by Devsinc (PVT) Limited.',
  },
  {
    title: '2. Description of Service',
    content: 'UnumPay is a Shopify-approved payment mediation application that connects Shopify merchants to multiple third-party payment gateways. UnumPay acts solely as a mediator between your Shopify store and your chosen payment providers. We do not process, hold, or transfer funds on your behalf.',
  },
  {
    title: '3. Eligibility',
    content: 'To use UnumPay you must own or operate an active Shopify store, be at least 18 years of age, have valid business registration where required, and comply with Shopifys own Terms of Service.',
  },
  {
    title: '4. Account Responsibilities',
    content: 'You are responsible for maintaining confidentiality of your account credentials, all activity that occurs under your account, providing accurate business information, and ensuring your use complies with all applicable local and international laws.',
  },
  {
    title: '5. Payment Gateways',
    content: "UnumPay provides access to 40+ third-party payment gateways. By connecting a gateway you also agree to that gateway's own terms. UnumPay is not responsible for the actions, fees, delays, failures, or policies of any third-party payment provider.",
  },
  {
    title: '6. Fees',
    content: 'UnumPay charges 0.85% per successful transaction. No setup fees, monthly subscriptions, or hidden charges. Devsinc (PVT) Limited reserves the right to update fees with 30 days prior notice.',
  },
  {
    title: '7.  Prohibited Uses',
    content:
      "You may not use UnumPay for illegal goods or services, counterfeit or fraudulent products, adult content or gambling, any activity violating Shopify's Acceptable Use Policy, or money laundering.",
  },
  {
    title: '8. Data and Privacy',
    content: 'We collect and process transaction data, store information, and usage data to provide the Service. We do not sell your data. Full details at www.unumpay.com/privacy-policy.',
  },
  {
    title: '9. Intellectual Property',
    content: 'All content and materials associated with UnumPay are the exclusive property of Devsinc (PVT) Limited.',
  },
  {
    title: '10. Limitation of Liability',
    content: 'Devsinc (PVT) Limited shall not be liable for indirect or consequential damages, loss of revenue from gateway failures, unauthorized access, or service interruptions. Total liability shall not exceed fees paid in the 30 days preceding the claim.',
  },
  {
    title: '11. Termination',
    content: 'Either party may terminate at any time. Devsinc (PVT) Limited may suspend access without notice for Terms violations. Data available for 30 days after termination.',
  },
  {
    title: '12. Governing Law',
    content: 'These Terms are governed by the laws of the United Arab Emirates. Disputes subject to jurisdiction of courts of Dubai, UAE.',
  },
  {
    title: '13. Changes to Terms',
    content: 'We will notify you of significant changes 14 days before they take effect via email or in-app notification.',
  },
  {
    title: '14. Contact Us',
    content:
      '<span class="privacy-section-text">unumpay@devsinc.com</span><br />' +
      '<span class="privacy-section-text">+92 300 0342357</span><br />' +
      '<span class="privacy-section-text">www.unumpay.com</span>',
  },
]
---

<div>
  <section class="pri-section pt-34! js-fade-scroll" data-direction="up">
    <div class="cta-section__glow" aria-hidden="true"></div>
    <div class="pri-content">
      <h1 class="privacy-policy-heading">Terms of Use</h1>

      <p class="privacy-policy-subtitle">
        Last updated April 2026 · Operated by Devsinc (PVT) Limited
      </p>
    </div>
  </section>

  <section class="privacy-policy-main-section js-fade-scroll" data-direction="up">
    <div class="privacy-content-container">
      {privacySections.map((section) => (
        <div class="privacy-section-item">
          <h3 class="privacy-section-title">{section.title}</h3>
          <p class="privacy-section-text" set:html={section.content} />
        </div>
      ))}
    </div>
  </section>
</div>